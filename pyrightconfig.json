{
  "include": [
    "custom_components/ecoflow_cloud"
  ],
  "exclude": [
    "core",
    "**/node_modules",
    "**/__pycache__",
    ".git",
    ".venv",
    "venv"
  ],
  "venvPath": "/home/vscode/.local",
  "venv": "ha-venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "off",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
